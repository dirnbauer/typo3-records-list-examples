{
    "name": "webconsulting/records-list-examples",
    "type": "typo3-cms-extension",
    "description": "TYPO3 v14 example view types for the Records List Types extension: Timeline, Catalog, Address Book, Event List, Gallery, and Dashboard.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Webconsulting",
            "email": "office@webconsulting.at",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-records-list-examples",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-records-list-examples/issues",
        "source": "https://github.com/dirnbauer/typo3-records-list-examples"
    },
    "require": {
        "php": "^8.4",
        "typo3/cms-backend": "^14.3.6",
        "typo3/cms-core": "^14.3.6",
        "typo3/cms-fluid": "^14.3.6",
        "typo3/cms-recordlist": "^14.3.6",
        "webconsulting/records-list-types": "^1.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.2.5 || ^12.1.2 || ^13.0.2",
        "saschaegerer/phpstan-typo3": "^3.0",
        "typo3/testing-framework": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\RecordsListExamples\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\RecordsListExamples\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "records_list_examples",
            "version": "1.2.1",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-records-list-types.git"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform": {
            "php": "8.4.0"
        }
    }
}
